% How to insert R-figure:
\begin{figure}[H]
\centering
<<echo=FALSE, fig.dim = c(4, 3)>>=
#' Because I always forget how to do this, I will also add a text with bold
#' parts in it to this example.
mytxt1 <- 'this is '
mytxt2 <- 'bold'
bq <- bquote('Just use the * sign to concatenate strings in expression: ' * .(mytxt1) * bold(.(mytxt2)))
### R plot:
plot(1:5)
text(x = 3, y=2, labels=bq)
@
\caption{CAPTION}
\label{FIGLABEL}
\end{figure}

%--------------------------------------------------
% How to insert figure:
\begin{figure}[H]
\centering
\setlength{\fboxrule}{0cm}\fbox{\includegraphics[width=0.75\columnwidth]{FIGNAME}}
\caption{CAPTION}
\label{FIGLABEL}
\end{figure}

% How to insert multiple images as subfigures:
% Uncomment the packages caption and subcaption in the preamble.
\begin{figure}[H]
     \centering
     \begin{subfigure}[b]{0.3\columnwidth}
         \centering
         \includegraphics[width=\columnwidth]{FIGNAME1}
         \caption{CAPTION1}
         \label{FIGLABEL1}
     \end{subfigure}
     \hfill   % To add space between images
     \begin{subfigure}[b]{0.3\columnwidth}
         \centering
         \includegraphics[width=\columnwidth]{FIGNAME2}
         \caption{CAPTION2}
         \label{FIGLABEL2}
     \end{subfigure}
     \hfill
     \begin{subfigure}[b]{0.3\columnwidth}
         \centering
         \includegraphics[width=\columnwidth]{FIGNAME3}
         \caption{CAPTION3}
         \label{FIGLABEL3}
     \end{subfigure}
        \caption{CAPTION}
        \label{FIGLABEL}
\end{figure}

%--------------------------------------------------
% How to insert a table:
% Table example (Use longtable package for tables over multiple pages, see example below):
\begin{table}[H]
\caption{CAPTION}
\label{TABLABEL}
\centering\medskip
\begin{tabular}{|rcl|}
\hline
\textbf{Right} & \textbf{Center} & \tcell[\tcW]{\textbf{tcell}}\\ \hline
a  & b  & \tcell[\tcW]{And here we go, so what do you think?}\\ \hline
c  & d  & \tcell[\tcW]{First \\ Second \\ Third}\\ \hline
\end{tabular}
\end{table}

