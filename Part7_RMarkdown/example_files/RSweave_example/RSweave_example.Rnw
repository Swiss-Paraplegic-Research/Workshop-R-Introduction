% With \tcell one can create a box inside a table to write text over multiple lines, can also force line break. Takes two arguments: Boxwidth and text to be printed. Apparently does not work with Rmarkdown.
\newcommand{\tcell}[2][4cm]{%
\setlength{\fboxsep}{3pt}%
\setlength{\fboxrule}{0pt}%
\fbox{\parbox[t]{#1}{#2}}%
}
% Command to have a fixed column width when using tcell:
\newcommand{\tcW}{3cm}


% TitleInfo:
\title{RSweave example}
\author{Yannick Rothacher}


